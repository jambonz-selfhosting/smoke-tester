# jambonz cluster
JAMBONZ_API_URL=https://jambonz.me/api/v1

# ---- Service-provider scope (mandatory; the only persistent identity) ----
# TestMain provisions an ephemeral account under this SP for each test
# suite (verbs / rest), mints an account-scope ApiKey for it, and tears
# the account down at suite end. The harness never touches resources
# whose name doesn't start with `it-<runID>-`.
JAMBONZ_SP_API_KEY=replace-with-your-sp-token
JAMBONZ_SP_SID=replace-with-your-sp-sid
# Let the media capture tests change the SP's support_audio_capture_policy.
# allow_all overrides every account's opt-out, so keep this off on a shared
# cluster that has customer accounts under the SP.
#JAMBONZ_ALLOW_SP_POLICY_CHANGES=true

# ---- SIP transport (verb tests; mandatory) ----
# Public IP of the cluster's SBC. Verb tests dial this IP directly for
# all SIP traffic; the synthetic per-account sip_realm has no real DNS,
# so the harness installs a *net.Resolver in the SIP transport that
# answers it locally with this IP.
JAMBONZ_SBC_PUBLIC_IP=replace-with-your-sbc-ip
# Optional zone suffix for the synthetic sip_realm. Default "smoke.test".
# Must contain at least one dot.
# JAMBONZ_SIP_REALM_ZONE=smoke.test

# ---- Webhook tunnel (mandatory) ----
NGROK_AUTHTOKEN=replace-with-your-ngrok-token
# Optional reserved subdomain (paid ngrok plans).
# NGROK_DOMAIN=

# ---- Third-party (mandatory) ----
DEEPGRAM_API_KEY=replace-with-your-deepgram-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# ---- Third-party (optional) ----
# Murf.ai TTS. When set, the Murf say test provisions a credential and runs;
# when unset, that test skips (passes) with a credential-missing log.
# MURF_API_KEY=replace-with-your-murf-key

# ElevenLabs TTS. When set, the eleven_v3 / eleven_v4 tests (Text to Dialogue
# websocket and one-shot say) and the stream-input regression run.
# ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key

# KugelAudio TTS. When set, the kugelaudio say/agent tests run; unset = skip.
# KUGELAUDIO_API_KEY=replace-with-your-kugelaudio-key
# Set when the media server has an ai-coustics license (AIC_SDK_LICENSE); enables the aicoustics noise tests.
# AICOUSTICS_ENABLED=true

# AssemblyAI TTS. When set, the assemblyai say/agent tests run; unset = skip.
# ASSEMBLYAI_API_KEY=replace-with-your-assemblyai-key

# Speechify TTS. When set, the speechify say/agent tests run; unset = skip.
# SPEECHIFY_API_KEY=replace-with-your-speechify-key

# Svara TTS. When set, the svara say/agent tests run; unset = skip.
# SVARA_VOICE_ID / SVARA_HINDI_VOICE_ID override the default library voices.
# SVARA_API_KEY=replace-with-your-svara-key
# SVARA_VOICE_ID=sv_a5thzx8v
# SVARA_HINDI_VOICE_ID=sv_fhn6tfve

# Giggy TTS. When set, the giggy say/agent tests run; unset = skip.
# GIGGY_VOICE_ID overrides the default English public voice (a UUID).
# GIGGY_API_KEY=replace-with-your-giggy-key
# GIGGY_VOICE_ID=8f5aee7d-dd96-41c4-b04f-19bff046b02a

# Mistral (Voxtral 3) realtime STT and TTS. When set, the mistral
# gather/transcribe/say/agent tests provision one credential and run;
# unset, they pass without exercising mistral.
# MISTRAL_API_KEY=replace-with-your-mistral-key

# Paxa Labs TTS and realtime STT. When set, the paxa gather/transcribe/say/
# agent tests provision one credential and run; unset, they pass without
# exercising paxa.
# PAXA_API_KEY=replace-with-your-paxa-key

# Sarvam AI TTS and realtime STT. When set, the sarvam gather/transcribe/say/
# agent tests provision one credential and run; unset, they pass without
# exercising sarvam.
# SARVAM_API_KEY=replace-with-your-sarvam-key

# Smallest AI TTS (Lightning) and realtime STT (Pulse). When set, the
# smallestai gather/transcribe/say/agent tests provision one credential and
# run; unset, they pass without exercising smallestai.
# SMALLESTAI_API_KEY=replace-with-your-smallestai-key

# Azure OpenAI realtime STT and /audio/speech TTS. When key and endpoint are
# both set, the azureopenai tests provision one credential and run; unset,
# they pass without exercising azureopenai. Deployments default to
# gpt-live-transcribe and gpt-4o-mini-tts.
# AZUREOPENAI_API_KEY=replace-with-your-azure-openai-key
# AZUREOPENAI_API_URI=https://myres.openai.azure.com
# AZUREOPENAI_STT_DEPLOYMENT=gpt-live-transcribe
# AZUREOPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts

# Gnani (Vachana) STT and TTS. When set, the gnani gather/transcribe/say/
# agent tests provision one credential and run; unset, they pass without
# exercising gnani.
# GNANI_API_KEY=replace-with-your-gnani-key

# Meta Muse Voice Transcribe STT. When set, the meta gather/transcribe/agent
# tests provision an STT-only credential and run; unset, they pass without
# exercising meta.
# META_API_KEY=replace-with-your-meta-key

# MiniMax TTS. When set, the minimax say/agent tests provision a credential
# and run; unset, they pass without exercising minimax.
# MINIMAX_VOICE_ID overrides the default en-US system voice.
# MINIMAX_API_KEY=replace-with-your-minimax-key
# MINIMAX_VOICE_ID=English_expressive_narrator

# Neuphonic TTS. When set, the neuphonic say/agent tests provision a credential
# and run; unset, they pass without exercising neuphonic.
# NEUPHONIC_VOICE_ID overrides the default en-US stock voice (Hannah).
# NEUPHONIC_API_KEY=replace-with-your-neuphonic-key
# NEUPHONIC_VOICE_ID=eeb488b8-d532-4235-aa57-f070cfc44750

# Camb.ai TTS. When set, the camb say/agent tests provision a credential and
# run; unset, they pass without exercising camb.
# CAMB_VOICE_ID overrides the default numeric voice (147320).
# CAMB_API_KEY=replace-with-your-camb-key
# CAMB_VOICE_ID=147320

# Async (vendor asyncai) TTS. When set, the asyncai say/agent tests provision a
# credential and run; unset, they pass without exercising asyncai.
# ASYNCAI_VOICE_ID overrides the default (only documented) voice.
# ASYNCAI_API_KEY=replace-with-your-async-key
# ASYNCAI_VOICE_ID=e0f39dc4-f691-4e78-bba5-5c636692cc04

# Respeecher TTS. When set, the respeecher say/agent tests provision a
# credential and run; unset, they pass without exercising respeecher.
# The free trial allows one concurrent request: run with -parallel 1.
# RESPEECHER_VOICE_ID overrides the default en-rt voice.
# RESPEECHER_API_KEY=replace-with-your-respeecher-key
# RESPEECHER_VOICE_ID=samantha

# Bland AI TTS. When set, the bland say/agent tests provision a credential
# and run; unset, they pass without exercising bland. The default org allows
# one concurrent request, so the bland tests never run in parallel.
# BLAND_VOICE_ID overrides the default voice (Karen).
# BLAND_API_KEY=replace-with-your-bland-key
# BLAND_VOICE_ID=29158307-9893-4149-8a75-bc9ce313d64e

# Simplismart TTS (HTTP only). When set, the simplismart say/agent tests
# provision a credential and run; unset, they pass without exercising it.
# SIMPLISMART_VOICE_ID overrides the default Orpheus voice (tara).
# SIMPLISMART_API_KEY=replace-with-your-simplismart-key
# SIMPLISMART_VOICE_ID=tara

# Spitch TTS (HTTP only). When set, the spitch say/agent tests provision a
# credential and run; unset, they pass without exercising it.
# SPITCH_VOICE_ID overrides the default English voice (lina).
# SPITCH_API_KEY=replace-with-your-spitch-key
# SPITCH_VOICE_ID=lina

# Kokoro TTS (self-hosted Kokoro-FastAPI, HTTP only). When KOKORO_API_URI is
# set, the kokoro say/agent tests provision a credential and run; unset, they
# pass without exercising it. KOKORO_API_KEY only if the server needs a token.
# KOKORO_API_URI=http://kokoro.example.internal:8880
# KOKORO_API_KEY=replace-with-your-kokoro-token
# KOKORO_VOICE_ID=af_heart

# Vakyam TTS (HTTP only). When set, the vakyam say/agent tests provision a
# credential and run; unset, they pass without exercising it. Run them with
# -parallel 1: the free plan allows one concurrent request.
# VAKYAM_API_KEY=replace-with-your-vakyam-key
# VAKYAM_VOICE_ID=Archana

# Groq TTS (Orpheus, HTTP only). When set, the groq say/agent tests provision
# a credential and run; unset, they pass without exercising it. Accept the
# Orpheus model terms in the Groq console first or every request 400s.
# GROQ_API_KEY=replace-with-your-groq-key
# GROQ_VOICE_ID=autumn

# Hume TTS (Octave). When set, the hume say/agent tests provision a credential
# and run; unset, they pass without exercising it. HUME_VOICE_ID is a library
# voice name or a voice UUID.
# HUME_API_KEY=replace-with-your-hume-key
# HUME_VOICE_ID=Ava Song

# Inworld realtime STT (the Portal Base64 Basic credential). When set, the
# inworld gather/transcribe/agent tests provision an STT-only credential and
# run; unset, they pass without exercising inworld.
# INWORLD_API_KEY=replace-with-your-inworld-key

# Soniox realtime TTS (one credential for STT and TTS; the key needs TTS
# permission). When set, the soniox say/agent tests provision a credential and
# run; unset, they pass without exercising soniox.
# SONIOX_API_KEY=replace-with-your-soniox-key

# Saidwire realtime STT (Deepgram-compatible /v1/listen). When set, the
# saidwire gather/transcribe/agent tests provision a credential and run;
# unset, they pass without exercising saidwire.
# SAIDWIRE_API_KEY=replace-with-your-saidwire-key

# Speechmatics STT. When set, the speechmatics gather/transcribe tests
# provision a credential and run (model selection + transcript_filtering_config);
# when unset, those tests pass without exercising speechmatics.
# SPEECHMATICS_API_KEY=replace-with-your-speechmatics-key
# Realtime host for the provisioned credential. Defaults to eu2.rt.speechmatics.com.
# SPEECHMATICS_STT_URI=eu2.rt.speechmatics.com
# The same key also provisions a TTS-only speechmatics credential (preview
# TTS host, voice sarah) for the speechmatics say/agent tests.

# Speechmatics Agent STT (vendor "speechmaticsagent", the /v2/agent/<profile>
# Linden endpoint). A SEPARATE key from SPEECHMATICS_API_KEY — different vendor,
# different endpoint, possibly different entitlement. When set, the agent-STT
# gather/transcribe tests run; when unset they pass without exercising it.
# SPEECHMATICS_AGENT_API_KEY=replace-with-your-speechmatics-agent-key
# Turn-taking profile the tests request. Defaults to smart.
# SPEECHMATICS_AGENT_PROFILE=smart
# Host override. Leave unset to use the media server's own default; set it to
# move the tests onto the production endpoints without a rebuild.
# Endpoint for the provisioned agent credential (speechmatics_stt_uri). Optional:
# unset means global.rt.speechmatics.com, which routes to the nearest region.
# Set it to pin a region, or to reach an on-prem host.
# SPEECHMATICS_AGENT_HOST=eu.rt.speechmatics.com

# Service-account key file for the Gemini Live transcription models, which run
# on Vertex AI and authenticate as a service account. The project needs billing
# and the account roles/aiplatform.user, which DIALOGFLOW_KEYFILE does not carry
# — hence a separate file. When set, the gemini gather/transcribe tests
# provision a google credential and run; when unset they pass without
# exercising gemini. Also drives TestVerb_LLM_Google_Vertex_ToolHook (Gemini
# Live s2s on Vertex AI, location us-central1).
# GEMINI_KEYFILE=/path/to/service-account.json

# Gemini Developer API key ("AIza...") from https://aistudio.google.com/apikey,
# for the google s2s (Gemini Live) tests. NOT the same credential as
# GEMINI_KEYFILE: Google refuses service accounts on the Developer API. When set, TestVerb_LLM_Google_ToolHook exercises Gemini Live tool calling;
# when unset it passes without exercising it.
# GEMINI_API_KEY=

# ---- Smoke-test licenses (commercial systems only) ----
# Only required when smoke testing a commercial (licensed) jambonz system,
# e.g. a cluster deployed from the public AMIs. An unlicensed commercial
# cluster accepts SIP REGISTERs but refuses call setup with
# "480 Temporarily Unavailable - Unlicensed", so every verb (call-flow)
# test times out without a license. Pre-generate one dedicated license per
# deployment size and paste them here; the fatp bootstrap script
# (bootstrap-sp-key.py --size <size>) activates the matching key on the
# cluster before the suite runs. Not needed for OSS/unlicensed clusters.
# FATP_LICENSE_MINI=replace-with-mini-smoke-license-jwt
# FATP_LICENSE_MEDIUM=replace-with-medium-smoke-license-jwt
# FATP_LICENSE_LARGE=replace-with-large-smoke-license-jwt

# ---- Test-run knobs ----
# RUN_ID=                       # short hex by default
# LOG_LEVEL=info                # info | debug
# ORPHAN_TTL_HOURS=2
# CONTRACT_STRICT=true          # schema violations fail tests (ADR-0015)

# ---- Per-leg call recording (ADR-0016; debugging aid) ----
# When on, every recorded call leg is also archived as a playable WAV at
# <RECORD_DIR>/<test-name>/<leg>.wav so you can hear back each leg after a
# run (e.g. recordings/TestVerb_Dial_User_Bridge/dial-caller.wav). Filenames
# are stable: re-running a test overwrites that test's own files, so disk
# stays bounded to the latest run. Off by default — leave it off for
# release-gate runs.
# RECORD_LEGS=true              # true/false, 1/0, on/off, yes/no
# RECORD_DIR=recordings         # base dir for the WAV archive

# OpenAI GPT-Live (GA) — s2s tests.
# Set GPTLIVE_API_KEY and TestVerb_LLM_GptLive_* exercise the real API; leave it
# unset and they pass without touching GPT-Live. The other four are optional
# overrides; empty means the feature-server default.
GPTLIVE_API_KEY=
# GPTLIVE_MODEL=gpt-live-1                    # voice model, sent in session.start
# GPTLIVE_DELEGATION_MODEL=gpt-5.5            # Responses-side model for delegated turns
# GPTLIVE_HOST=api.openai.com                 # empty = feature-server default
# GPTLIVE_PATH=v1/live/sessions               # empty = feature-server default

# --- Google Dialogflow (dialogflow verb) -----------------------------------
# Credentials are passed INLINE to the verb, so nothing is provisioned via
# /SpeechCredentials. Unset => the dialogflow tests skip (pass) with a log.
# DIALOGFLOW_KEYFILE=/path/to/service-account.json
# DIALOGFLOW_PROJECT=my-gcp-project
# DIALOGFLOW_REGION=us-central1               # regional API host is mandatory
# DIALOGFLOW_LANG=en-US
#
# CX (model "cx") — TestVerb_Dialogflow_CX
# DIALOGFLOW_AGENT=00000000-0000-0000-0000-000000000000   # CX agent id (uuid)
#
# CES / Conversational Agents (model "ces") — TestVerb_Dialogflow_CES.
# A CES app is a DIFFERENT GCP resource from a CX agent: DIALOGFLOW_AGENT is
# NOT a substitute. The app must expose a client-side (Function) tool with a
# NON-EMPTY DESCRIPTION — an empty description is never offered to the model,
# which presents as a silent stall rather than an error.
# DIALOGFLOW_CES_APP=my-ces-app-id
# DIALOGFLOW_CES_DEPLOYMENT=                  # optional; empty = app default
# CES location. NOT the same as DIALOGFLOW_REGION: a CES app commonly lives in a
# MULTI-REGION ("us") while a CX agent lives in a region ("us-central1").
# DIALOGFLOW_CES_LOCATION=us
#
# The prompts and canned tool output are hardcoded fixtures in the test (as in
# the CX test), not env vars: the assertions are specific to that app.

# Azure Voice Live — s2s tests (TestVerb_LLM_VoiceLive_*).
# BOTH the key and the host are required, unlike every other s2s vendor: the
# Voice Live endpoint is per-resource, so there is no default host to fall back
# on. Leave either unset and the tests pass without touching Azure.
#
# VOICELIVE_HOST is the "Keys and Endpoint" value with the scheme and trailing
# slash stripped: https://my-resource.services.ai.azure.com/ -> the line below.
# Only a Microsoft Foundry resource (kind=AIServices, SKU S0) has an endpoint
# of that shape. A plain Speech resource only has the SHARED regional gateway
# https://<region>.api.cognitive.microsoft.com/, which Voice Live rejects with
# 401 "use a correct regional API endpoint for your resource" — and no amount of
# URL editing fixes it, because the per-resource name does not exist in DNS
# until the resource is created with one:
#   az cognitiveservices account create -n <name> -g <rg> \
#     --kind AIServices --sku S0 -l eastus --yes
VOICELIVE_API_KEY=
# VOICELIVE_HOST=my-resource.services.ai.azure.com
#
# Model availability is per-region; these were confirmed in eastus. Note that
# gpt-realtime and azure-realtime are NOT offered there.
#   native s2s : gpt-realtime-2.1, gpt-realtime-2.1-mini
#   cascaded   : gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, gpt-4o, gpt-5, gpt-5-mini
# Cascaded (Azure STT -> text LLM -> Azure TTS) is the stricter test: a native
# model still speaks in its own voice if the session config was mangled, while
# a cascaded one goes silent.
# VOICELIVE_MODEL=gpt-realtime-2.1
# Azure TTS voice. Only has an audible effect in cascaded mode.
# VOICELIVE_VOICE=en-US-AvaNeural

# Amazon Nova Sonic on Bedrock — s2s tests (TestVerb_LLM_Nova_*).
# IAM credentials allowed bedrock:InvokeModelWithBidirectionalStream on the
# model. Temporary STS/SSO creds work too (set the session token), e.g.
#   aws configure export-credentials --profile <p> --format env
# Leave the keys unset and the tests pass without touching AWS.
# Nova Sonic regions: us-east-1, us-west-2, eu-north-1, ap-northeast-1.
NOVA_ACCESS_KEY_ID=
NOVA_SECRET_ACCESS_KEY=
# NOVA_SESSION_TOKEN=
# NOVA_REGION=us-east-1
# NOVA_MODEL=amazon.nova-2-5-sonic
# NOVA_VOICE=tiffany

# Agent Studio — make test-studio (tests/studio). Calls an order-desk agent on
# every realtime voice API vendor that has a key above, through the Studio
# workspace's jambonz connection; JAMBONZ_API_URL must be the same cluster.
# Leave STUDIO_API_URL unset and the suite does nothing.
# STUDIO_API_URL=https://studio.jambonz.io/v1
# Sign in once per run with the email and password, or reuse a session cookie
# value saved in a file (Studio rate-limits sign-in).
# STUDIO_EMAIL=
# STUDIO_PASSWORD=
# STUDIO_SID_FILE=
# Empty: the login's first workspace it owns or administers.
# STUDIO_ACCOUNT_ID=
# Where each call's audio, transcript and result.json go (default: a temp dir).
# STUDIO_OUT_DIR=
# Vertex region for the google-vertex agent (GEMINI_KEYFILE is its key).
# VERTEX_REGION=us-central1
# Vendors only the Studio suite calls.
# QWEN_API_KEY=
# QWEN_HOST=dashscope-intl.aliyuncs.com
# QWEN_MODEL=
# AZURE_OPENAI_REALTIME_API_KEY=
# AZURE_OPENAI_REALTIME_HOST=
# AZURE_OPENAI_REALTIME_DEPLOYMENT=
