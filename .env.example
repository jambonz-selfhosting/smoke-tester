# jambonz cluster
JAMBONZ_API_URL=https://jambonz.me/api/v1

# ---- Service-provider scope (mandatory; the only persistent identity) ----
# TestMain provisions an ephemeral account under this SP for each test
# suite (verbs / rest), mints an account-scope ApiKey for it, and tears
# the account down at suite end. The harness never touches resources
# whose name doesn't start with `it-<runID>-`.
JAMBONZ_SP_API_KEY=replace-with-your-sp-token
JAMBONZ_SP_SID=replace-with-your-sp-sid

# ---- SIP transport (verb tests; mandatory) ----
# Public IP of the cluster's SBC. Verb tests dial this IP directly for
# all SIP traffic; the synthetic per-account sip_realm has no real DNS,
# so the harness installs a *net.Resolver in the SIP transport that
# answers it locally with this IP.
JAMBONZ_SBC_PUBLIC_IP=replace-with-your-sbc-ip
# Optional zone suffix for the synthetic sip_realm. Default "smoke.test".
# Must contain at least one dot.
# JAMBONZ_SIP_REALM_ZONE=smoke.test

# ---- Webhook tunnel (mandatory) ----
NGROK_AUTHTOKEN=replace-with-your-ngrok-token
# Optional reserved subdomain (paid ngrok plans).
# NGROK_DOMAIN=

# ---- Third-party (mandatory) ----
DEEPGRAM_API_KEY=replace-with-your-deepgram-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# ---- Third-party (optional) ----
# Murf.ai TTS. When set, the Murf say test provisions a credential and runs;
# when unset, that test skips (passes) with a credential-missing log.
# MURF_API_KEY=replace-with-your-murf-key

# Speechmatics STT. When set, the speechmatics gather/transcribe tests
# provision a credential and run (model selection + transcript_filtering_config);
# when unset, those tests pass without exercising speechmatics.
# SPEECHMATICS_API_KEY=replace-with-your-speechmatics-key
# Realtime host for the provisioned credential. Defaults to eu2.rt.speechmatics.com.
# SPEECHMATICS_STT_URI=eu2.rt.speechmatics.com

# Speechmatics Agent STT (vendor "speechmaticsagent", the /v2/agent/<profile>
# Linden endpoint). A SEPARATE key from SPEECHMATICS_API_KEY — different vendor,
# different endpoint, possibly different entitlement. When set, the agent-STT
# gather/transcribe tests run; when unset they pass without exercising it.
# SPEECHMATICS_AGENT_API_KEY=replace-with-your-speechmatics-agent-key
# Turn-taking profile the tests request. Defaults to smart.
# SPEECHMATICS_AGENT_PROFILE=smart
# Host override. Leave unset to use the media server's own default; set it to
# move the tests onto the production endpoints without a rebuild.
# Endpoint for the provisioned agent credential (speechmatics_stt_uri). Optional:
# unset means global.rt.speechmatics.com, which routes to the nearest region.
# Set it to pin a region, or to reach an on-prem host.
# SPEECHMATICS_AGENT_HOST=eu.rt.speechmatics.com

# Service-account key file for the Gemini Live transcription models, which run
# on Vertex AI and authenticate as a service account. The project needs billing
# and the account roles/aiplatform.user, which DIALOGFLOW_KEYFILE does not carry
# — hence a separate file. When set, the gemini gather/transcribe tests
# provision a google credential and run; when unset they pass without
# exercising gemini.
# GEMINI_KEYFILE=/path/to/service-account.json

# Gemini Developer API key ("AIza...") from https://aistudio.google.com/apikey,
# for the google s2s (Gemini Live) tests. NOT the same credential as
# GEMINI_KEYFILE: Google refuses service accounts on the Developer API, and
# gemini-3.8-live / -extended-thinking are not published on Vertex AI (they are
# allowlist-gated there), which is the only API the service account can reach.
# When set, TestVerb_LLM_Google_ToolHook exercises Gemini Live tool calling;
# when unset it passes without exercising it.
# GEMINI_API_KEY=

# ---- Smoke-test licenses (commercial systems only) ----
# Only required when smoke testing a commercial (licensed) jambonz system,
# e.g. a cluster deployed from the public AMIs. An unlicensed commercial
# cluster accepts SIP REGISTERs but refuses call setup with
# "480 Temporarily Unavailable - Unlicensed", so every verb (call-flow)
# test times out without a license. Pre-generate one dedicated license per
# deployment size and paste them here; the fatp bootstrap script
# (bootstrap-sp-key.py --size <size>) activates the matching key on the
# cluster before the suite runs. Not needed for OSS/unlicensed clusters.
# FATP_LICENSE_MINI=replace-with-mini-smoke-license-jwt
# FATP_LICENSE_MEDIUM=replace-with-medium-smoke-license-jwt
# FATP_LICENSE_LARGE=replace-with-large-smoke-license-jwt

# ---- Test-run knobs ----
# RUN_ID=                       # short hex by default
# LOG_LEVEL=info                # info | debug
# ORPHAN_TTL_HOURS=2
# CONTRACT_STRICT=true          # schema violations fail tests (ADR-0015)

# ---- Per-leg call recording (ADR-0016; debugging aid) ----
# When on, every recorded call leg is also archived as a playable WAV at
# <RECORD_DIR>/<test-name>/<leg>.wav so you can hear back each leg after a
# run (e.g. recordings/TestVerb_Dial_User_Bridge/dial-caller.wav). Filenames
# are stable: re-running a test overwrites that test's own files, so disk
# stays bounded to the latest run. Off by default — leave it off for
# release-gate runs.
# RECORD_LEGS=true              # true/false, 1/0, on/off, yes/no
# RECORD_DIR=recordings         # base dir for the WAV archive

# OpenAI GPT Live (limited-access alpha) — s2s tests.
# Set GPTLIVE_API_KEY and TestVerb_LLM_GptLive_* exercise the real API; leave it
# unset and they pass without touching GPT Live. It must be an OpenAI key
# ENROLLED in the Early Access Program: an ordinary key completes the websocket
# handshake and is then refused with "Voice session access denied".
# The remaining four are field-correctable overrides for an alpha whose model
# names and connection URL are not contractually stable.
GPTLIVE_API_KEY=
# GPTLIVE_MODEL=gpt-live-1                    # voice model, rides in the URL
# GPTLIVE_DELEGATION_MODEL=gpt-5.5            # Responses-side model for delegated turns
# GPTLIVE_HOST=api.openai.com                 # empty = feature-server default
# GPTLIVE_PATH=v1/live?model=<model>          # empty = feature-server default

# --- Google Dialogflow (dialogflow verb) -----------------------------------
# Credentials are passed INLINE to the verb, so nothing is provisioned via
# /SpeechCredentials. Unset => the dialogflow tests skip (pass) with a log.
# DIALOGFLOW_KEYFILE=/path/to/service-account.json
# DIALOGFLOW_PROJECT=my-gcp-project
# DIALOGFLOW_REGION=us-central1               # regional API host is mandatory
# DIALOGFLOW_LANG=en-US
#
# CX (model "cx") — TestVerb_Dialogflow_CX
# DIALOGFLOW_AGENT=00000000-0000-0000-0000-000000000000   # CX agent id (uuid)
#
# CES / Conversational Agents (model "ces") — TestVerb_Dialogflow_CES.
# A CES app is a DIFFERENT GCP resource from a CX agent: DIALOGFLOW_AGENT is
# NOT a substitute. The app must expose a client-side (Function) tool with a
# NON-EMPTY DESCRIPTION — an empty description is never offered to the model,
# which presents as a silent stall rather than an error.
# DIALOGFLOW_CES_APP=my-ces-app-id
# DIALOGFLOW_CES_DEPLOYMENT=                  # optional; empty = app default
# CES location. NOT the same as DIALOGFLOW_REGION: a CES app commonly lives in a
# MULTI-REGION ("us") while a CX agent lives in a region ("us-central1").
# DIALOGFLOW_CES_LOCATION=us
#
# The prompts and canned tool output are hardcoded fixtures in the test (as in
# the CX test), not env vars: the assertions are specific to that app.

# Azure Voice Live — s2s tests (TestVerb_LLM_VoiceLive_*).
# BOTH the key and the host are required, unlike every other s2s vendor: the
# Voice Live endpoint is per-resource, so there is no default host to fall back
# on. Leave either unset and the tests pass without touching Azure.
#
# VOICELIVE_HOST is the "Keys and Endpoint" value with the scheme and trailing
# slash stripped: https://my-resource.services.ai.azure.com/ -> the line below.
# Only a Microsoft Foundry resource (kind=AIServices, SKU S0) has an endpoint
# of that shape. A plain Speech resource only has the SHARED regional gateway
# https://<region>.api.cognitive.microsoft.com/, which Voice Live rejects with
# 401 "use a correct regional API endpoint for your resource" — and no amount of
# URL editing fixes it, because the per-resource name does not exist in DNS
# until the resource is created with one:
#   az cognitiveservices account create -n <name> -g <rg> \
#     --kind AIServices --sku S0 -l eastus --yes
VOICELIVE_API_KEY=
# VOICELIVE_HOST=my-resource.services.ai.azure.com
#
# Model availability is per-region; these were confirmed in eastus. Note that
# gpt-realtime and azure-realtime are NOT offered there.
#   native s2s : gpt-realtime-2.1, gpt-realtime-2.1-mini
#   cascaded   : gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, gpt-4o, gpt-5, gpt-5-mini
# Cascaded (Azure STT -> text LLM -> Azure TTS) is the stricter test: a native
# model still speaks in its own voice if the session config was mangled, while
# a cascaded one goes silent.
# VOICELIVE_MODEL=gpt-realtime-2.1
# Azure TTS voice. Only has an audible effect in cascaded mode.
# VOICELIVE_VOICE=en-US-AvaNeural
