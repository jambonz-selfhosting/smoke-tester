.env
.env.local
# per-cluster env files carry live secrets (API keys, ngrok token, Deepgram
# key). Never commit them; only the annotated template is tracked.
.env.*
!.env.example
bin/
*.wav
!tests/verbs/testdata/*.wav
# agent test cache: TTS-generated prompts. Re-creatable from internal/tts;
# safe to commit once generated so CI without DEEPGRAM_API_KEY can run, but
# also safe to delete and regenerate.
!tests/verbs/testdata/agent/*.wav
# listen `mark` test playback audio — same policy as the agent cache:
# TTS-generated, re-creatable from internal/tts, safe to commit so CI
# without DEEPGRAM_API_KEY can run the bidirectional-audio path.
!tests/verbs/testdata/listen/*.wav
# AMD test greetings (short/long) — same policy as agent/listen: TTS-generated,
# re-creatable from internal/tts, safe to commit so CI without DEEPGRAM_API_KEY
# can run the amd human/machine detection tests.
!tests/verbs/testdata/amd/*.wav
*.pcap
.DS_Store
# per-leg call recording archives (RECORD_LEGS, ADR-0016)
recordings/
coverage.out
report.xml
report.html

# generated binaries
testreport

# editor / agent noise
.vscode/
.idea/
.claude/
